<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@android:color/white">

        <!-- نوار رنگی سمت راست شبیه وب -->
        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="#0d6efd"
            android:layout_gravity="start"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCaseNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="کلاسه: ---"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212529" />

        <TextView
            android:id="@+id/tvContracts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#6c757d"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- بخش تعداد اوراق (فقط برای نقش‌هایی که نیاز دارند) -->
        <LinearLayout
            android:id="@+id/layoutPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تعداد اوراق:"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#212529"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etPages"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:inputType="number"
                android:gravity="center"
                android:background="@drawable/bg_edit_pages"
                android:hint="برگ"
                android:textColor="#212529"
                android:textColorHint="#6c757d"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tvPrevPages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaim"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="تخصیص و ثبت در سابقه من"
            android:textSize="14sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#198754"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
